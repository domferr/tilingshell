#: dist/prefs.js:65
msgid "Configure the appearance of Tiling Shell"
msgstr "Skonfiguruj wygląd Układania okien"

#: dist/prefs.js:70
msgid "Show Indicator"
msgstr "Pokaż wskaźnik"

